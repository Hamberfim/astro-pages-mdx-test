---
const tabTitle = "Five Page Marketing Site";
const mainTitle = "Five Page Marketing Site";
const desc =
  "A complete, five-page marketing website to grow your small business—live in less than 14 days for a flat fee of $900. We build and launch your essential pages, including your company story, services, and contact info, on a lightning-fast, ultra-secure hosting network. The package comes standard with an AI-powered contact form that automatically filters out spam, categorizes real inquiries by where they found you, and sends clean leads straight into your customer database.";
---

<html lang="en" class="bg-gray-50 font-sans-serif text-gray-900 ms-3">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{tabTitle}</title>
  </head>
  <body>
    <header></header>
    <nav>
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/services/">Services</a>
      <a href="/blog/">Blog</a>
    </nav>
    <main>
      <section>
        <h1>{mainTitle}</h1>
        <h2>An Astro, Page CMS site with MDX(jsx)</h2>
        <p>{desc}</p>
      </section>
      <section></section>
    </main>
    <footer></footer>
  </body>
</html>
